{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(logo\\.svg|logo-mark\\.svg|favicon\\.svg|og-default\\.png)",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/(sitemap\\.xml|robots\\.txt|rss\\.xml)",
      "headers": {
        "cache-control": "public, max-age=3600, stale-while-revalidate=86400"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
