rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCategory(cat) {
      return cat in ['chat', 'coding', 'image', 'video', 'audio', 'research', 'writing', 'productivity', 'design', 'marketing'];
    }

    function isValidPricing(p) {
      return p in ['Free', 'Freemium', 'Paid', 'Free Trial'];
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'slug', 'tagline', 'category', 'pricing', 'websiteUrl', 'status', 'createdAt'])
        && data.ownerUid == request.auth.uid
        && data.status == 'pending'
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.tagline is string && data.tagline.size() >= 5 && data.tagline.size() <= 250
        && (!('description' in data) || (data.description is string && data.description.size() <= 3000))
        && isValidCategory(data.category)
        && isValidPricing(data.pricing)
        && (!('startingPrice' in data) || (data.startingPrice is string && data.startingPrice.size() <= 50))
        && (!('hasFreeTier' in data) || data.hasFreeTier is bool)
        && data.websiteUrl is string && data.websiteUrl.size() >= 8 && data.websiteUrl.size() <= 300
        && (!('bestFor' in data) || (data.bestFor is string && data.bestFor.size() <= 300))
        && (!('keyFeatures' in data) || (data.keyFeatures is list && data.keyFeatures.size() <= 10))
        && (!('pros' in data) || (data.pros is list && data.pros.size() <= 10))
        && (!('cons' in data) || (data.cons is list && data.cons.size() <= 10));
    }

    // Users collection: only the owner can read or write their profile and subcollections (favorites)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Submissions collection: authenticated users can create their own pending submission, and only read their own
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && isValidSubmission(incoming());
      allow update, delete: if false;
    }

    // Benchmark history: public read access for all clients, no client writes permitted
    match /benchmarkHistory/{dateId} {
      allow read: if true;
      allow write: if false;
    }

    // Published community models: public read, write denied to public clients
    match /models/{modelId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
