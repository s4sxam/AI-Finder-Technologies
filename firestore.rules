rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all reads and writes across the database
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'ADMIN_EMAIL_PLACEHOLDER'
        && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCategory(cat) {
      return cat in ['chat', 'coding', 'image', 'video', 'audio', 'research', 'writing', 'productivity', 'design', 'marketing'];
    }

    function isValidPricing(p) {
      return p in ['Free', 'Freemium', 'Paid', 'Free Trial'];
    }

    function isValidDomainKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 128 && key.matches('^[a-z0-9.-]+$');
    }

    function isValidSlug(s) {
      return s is string && s.size() >= 2 && s.size() <= 100 && s.matches('^[a-z0-9-]+$');
    }

    function checkBatchSubmissionLimit(uid) {
      let limitPath = /databases/$(database)/documents/users/$(uid)/limits/submissions;
      let limitAfter = getAfter(limitPath);
      return limitAfter != null
        && limitAfter.data.count is int
        && limitAfter.data.count <= 5
        && (
          // Either brand new limit document with count == 1
          limitAfter.data.count == 1
          // Or incremented exactly by 1 in this batch
          || (exists(limitPath) && limitAfter.data.count == get(limitPath).data.count + 1)
        );
    }

    function isValidCommunityTool(data) {
      return data.keys().hasOnly([
          'name', 'slug', 'websiteUrl', 'domainKey', 'description',
          'category', 'pricing', 'tags', 'logoUrl', 'ownerUid',
          'submitterName', 'submitterPhotoURL', 'showSubmitter',
          'createdAt', 'hidden', 'source'
        ])
        && data.ownerUid == request.auth.uid
        && data.source == 'community'
        && data.hidden == false
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && isValidSlug(data.slug)
        && data.websiteUrl is string
        && data.websiteUrl.matches('^https://[^\\s]+$')
        && data.websiteUrl.size() >= 8 && data.websiteUrl.size() <= 300
        && isValidDomainKey(data.domainKey)
        && data.description is string && data.description.size() >= 20 && data.description.size() <= 300
        && isValidCategory(data.category)
        && isValidPricing(data.pricing)
        && data.tags is list && data.tags.size() <= 10
        && data.logoUrl is string && data.logoUrl.matches('^https://[^\\s]+$') && data.logoUrl.size() <= 500
        && data.submitterName is string && data.submitterName.size() <= 100
        && data.submitterPhotoURL is string && data.submitterPhotoURL.size() <= 500
        && data.showSubmitter is bool
        && data.createdAt == request.time;
    }

    // Community Tools collection:
    // Public read excludes hidden tools (admin can read all)
    // Create enforces batch limits, valid schema, https URLs, duplicate domain prevention
    // Owner can only edit description, tags, showSubmitter
    // Admin can toggle hidden kill switch or delete
    match /communityTools/{domainKey} {
      allow read: if resource.data.hidden != true || isAdmin();
      
      allow create: if isSignedIn()
        && isValidDomainKey(domainKey)
        && domainKey == incoming().domainKey
        && isValidCommunityTool(incoming())
        && checkBatchSubmissionLimit(request.auth.uid);

      allow update: if (
          // Owner edit
          isOwner(resource.data.ownerUid)
          && incoming().diff(resource.data).affectedKeys().hasOnly(['description', 'tags', 'showSubmitter'])
          && incoming().description is string && incoming().description.size() >= 20 && incoming().description.size() <= 300
          && incoming().tags is list && incoming().tags.size() <= 10
          && incoming().showSubmitter is bool
          && incoming().domainKey == resource.data.domainKey
          && incoming().ownerUid == resource.data.ownerUid
          && incoming().createdAt == resource.data.createdAt
          && incoming().hidden == resource.data.hidden
          && incoming().source == resource.data.source
        ) || (
          // Admin kill switch toggle
          isAdmin()
          && incoming().diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && incoming().hidden is bool
        );

      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // Reports collection: authenticated user can submit a report on a domainKey, no public reads
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if isSignedIn()
        && reportId == incoming().domainKey + '_' + request.auth.uid
        && incoming().keys().hasOnly(['domainKey', 'slug', 'reason', 'details', 'reporterUid', 'reporterName', 'createdAt'])
        && incoming().reporterUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().reason in ['spam', 'broken_link', 'malware', 'impersonation', 'offensive', 'other']
        && (!('details' in incoming()) || (incoming().details is string && incoming().details.size() <= 500))
        && isValidDomainKey(incoming().domainKey)
        && isValidSlug(incoming().slug)
        && incoming().reporterName is string && incoming().reporterName.size() <= 100;
    }

    // Users collection: user owns account profile; NO recursive wildcards
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Bookmarks / favorites subcollection
      match /favorites/{toolId} {
        allow read, write: if isOwner(userId);
      }

      // Hardened submission rate limits document
      match /limits/submissions {
        allow read: if isOwner(userId);
        allow delete: if false;

        allow create: if isOwner(userId)
          && incoming().keys().hasOnly(['count', 'windowStart'])
          && incoming().count == 1
          && incoming().windowStart == request.time;

        allow update: if isOwner(userId)
          && incoming().keys().hasOnly(['count', 'windowStart'])
          && (
            // Same window increment (max 5)
            (incoming().windowStart == resource.data.windowStart && incoming().count == resource.data.count + 1 && incoming().count <= 5)
            ||
            // 24-hour reset
            (request.time > resource.data.windowStart + duration.value(24, 'h') && incoming().count == 1 && incoming().windowStart == request.time)
          );
      }
    }

    // Benchmark history: public read access, no client writes permitted
    match /benchmarkHistory/{dateId} {
      allow read: if true;
      allow write: if false;
    }

    // Published community models: public read, write denied to public clients
    match /models/{modelId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
