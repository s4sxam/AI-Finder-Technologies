{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing public display name and avatar",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "A bookmarked/favorited AI tool for the user",
      "type": "object",
      "properties": {
        "toolSlug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["toolSlug", "addedAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Tool submission awaiting editorial review",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerDisplayName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": {
          "type": "string",
          "enum": ["chat", "coding", "image", "video", "audio", "research", "writing", "productivity", "design", "marketing"]
        },
        "pricing": {
          "type": "string",
          "enum": ["Free", "Freemium", "Paid", "Free Trial"]
        },
        "startingPrice": { "type": "string", "maxLength": 50 },
        "hasFreeTier": { "type": "boolean" },
        "websiteUrl": { "type": "string", "maxLength": 300 },
        "bestFor": { "type": "string", "maxLength": 300 },
        "keyFeatures": { "type": "array" },
        "pros": { "type": "array" },
        "cons": { "type": "array" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "name", "slug", "tagline", "category", "pricing", "websiteUrl", "status", "createdAt"]
    },
    "BenchmarkDailySnapshot": {
      "title": "BenchmarkDailySnapshot",
      "description": "Daily snapshot of frontier LLM performance benchmarks",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "topModels": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "topModels", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profile document containing non-sensitive account metadata"
    },
    "/users/{userId}/favorites/{toolSlug}": {
      "schema": "#/entities/UserFavorite",
      "description": "Saved favorite tools subcollection for a user"
    },
    "/submissions/{submissionId}": {
      "schema": "#/entities/Submission",
      "description": "User submitted tools submitted for directory curation"
    },
    "/benchmarkHistory/{dateId}": {
      "schema": "#/entities/BenchmarkDailySnapshot",
      "description": "Public daily performance snapshot archives"
    }
  }
}
