{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing public display name and avatar",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "A bookmarked/favorited AI tool for the user",
      "type": "object",
      "properties": {
        "toolSlug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["toolSlug", "addedAt"]
    },
    "SubmissionLimit": {
      "title": "SubmissionLimit",
      "description": "Rate limiting tracking document for daily community tool submissions",
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "windowStart": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["count", "windowStart"]
    },
    "CommunityTool": {
      "title": "CommunityTool",
      "description": "Publicly published AI tool with instant directory availability",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "minLength": 2 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100, "minLength": 2 },
        "websiteUrl": { "type": "string", "maxLength": 300, "minLength": 8 },
        "domainKey": { "type": "string", "pattern": "^[a-z0-9._-]+$", "maxLength": 128, "minLength": 3 },
        "description": { "type": "string", "maxLength": 300, "minLength": 20 },
        "category": {
          "type": "string",
          "enum": ["chat", "coding", "image", "video", "audio", "research", "writing", "productivity", "design", "marketing"]
        },
        "pricing": {
          "type": "string",
          "enum": ["Free", "Freemium", "Paid", "Free Trial"]
        },
        "tags": { "type": "array" },
        "logoUrl": { "type": "string", "maxLength": 300 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "submitterName": { "type": "string", "maxLength": 100 },
        "submitterPhotoURL": { "type": "string", "maxLength": 500 },
        "showSubmitter": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "hidden": { "type": "boolean" },
        "source": { "type": "string", "enum": ["community"] }
      },
      "required": [
        "name", "slug", "websiteUrl", "domainKey", "description",
        "category", "pricing", "tags", "logoUrl", "ownerUid",
        "submitterName", "submitterPhotoURL", "showSubmitter",
        "createdAt", "hidden", "source"
      ]
    },
    "ToolReport": {
      "title": "ToolReport",
      "description": "User flagged content or abuse report on a community submitted AI tool",
      "type": "object",
      "properties": {
        "domainKey": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 100 },
        "reason": { "type": "string", "maxLength": 500, "minLength": 5 },
        "reporterUid": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["domainKey", "slug", "reason", "reporterUid", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Legacy tool submission record",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerDisplayName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": {
          "type": "string",
          "enum": ["chat", "coding", "image", "video", "audio", "research", "writing", "productivity", "design", "marketing"]
        },
        "pricing": {
          "type": "string",
          "enum": ["Free", "Freemium", "Paid", "Free Trial"]
        },
        "websiteUrl": { "type": "string", "maxLength": 300 },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "migrated": { "type": "boolean" }
      },
      "required": ["ownerUid", "name", "slug", "tagline", "category", "pricing", "websiteUrl", "status", "createdAt"]
    },
    "BenchmarkDailySnapshot": {
      "title": "BenchmarkDailySnapshot",
      "description": "Daily snapshot of frontier LLM performance benchmarks",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "topModels": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "topModels", "createdAt"]
    }
  },
  "firestore": {
    "/communityTools/{domainKey}": {
      "schema": "#/entities/CommunityTool",
      "description": "Live directory of community-submitted AI tools keyed by unique domainKey"
    },
    "/reports/{reportId}": {
      "schema": "#/entities/ToolReport",
      "description": "Content flags and abuse reports on community tools"
    },
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profile document containing non-sensitive account metadata"
    },
    "/users/{userId}/favorites/{toolSlug}": {
      "schema": "#/entities/UserFavorite",
      "description": "Saved favorite tools subcollection for a user"
    },
    "/users/{userId}/limits/submissions": {
      "schema": "#/entities/SubmissionLimit",
      "description": "Daily submission rate limit tracker per user"
    },
    "/submissions/{submissionId}": {
      "schema": "#/entities/Submission",
      "description": "Legacy user submitted tools records"
    },
    "/benchmarkHistory/{dateId}": {
      "schema": "#/entities/BenchmarkDailySnapshot",
      "description": "Public daily performance snapshot archives"
    }
  }
}
