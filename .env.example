# AI Finder Technologies Environment Variables Configuration

# Site URL Configuration (Used for canonical URLs, RSS, sitemap, and OpenGraph metadata)
VITE_SITE_URL=https://ai-finder-ruddy.vercel.app
VITE_APP_URL=https://ai-finder-ruddy.vercel.app
APP_URL=https://ai-finder-ruddy.vercel.app

# Server & Port Configuration (Optional, defaults to 3000)
PORT=3000
NODE_ENV=development

# Live Benchmark Integrations (Optional)
# If provided, enables automated intelligence index refresh from Artificial Analysis API v2.
# If omitted, OpenRouter live prices and verified baseline intelligence data are utilized.
ARTIFICIAL_ANALYSIS_API_KEY=

# Contact Form Delivery via Resend (Phase 3)
# Get your API key at https://resend.com
RESEND_API_KEY=
# Destination inbox for incoming contact submissions (defaults to team@aifindertech.internal if omitted)
CONTACT_TO_EMAIL=hello@aifindertechnologies.com

# Newsletter Audience Provider (Phase 3)
# Option A: Resend Audience
RESEND_AUDIENCE_ID=
# Option B: Buttondown Newsletter
BUTTONDOWN_API_KEY=

# Cloudflare Turnstile Bot Protection (Phase 3 - Optional)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Firebase App Check (Phase 5 - Optional)
# reCAPTCHA v3 Site Key for Firestore client App Check attestation
VITE_APPCHECK_SITE_KEY=

# Privacy-Friendly Analytics (Phase 9 - Optional)
# Plausible analytics domain (e.g. ai-finder.com). Script is only loaded when set.
VITE_PLAUSIBLE_DOMAIN=