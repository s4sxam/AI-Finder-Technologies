# AI Finder Technologies Environment Configuration
# Copy this file to .env.local or configure in your deployment platform (Vercel, GitHub Actions)

# 1. Base Application Domain & URL (used for canonical tags, sitemaps, and OpenGraph previews)
VITE_APP_URL="https://ai-finder-ruddy.vercel.app"
APP_URL="https://ai-finder-ruddy.vercel.app"

# 2. Benchmarks Refresh Key (used in GitHub Actions cron and scripts/fetch-benchmarks.ts)
# Obtain a key from https://artificialanalysis.ai/account
ARTIFICIAL_ANALYSIS_API_KEY="your_artificial_analysis_api_key_here"

# 3. Gemini AI API Key (server-side operations)
GEMINI_API_KEY="your_gemini_api_key_here"

# 4. Optional Privacy Analytics (Plausible or GA4)
# VITE_PLAUSIBLE_DOMAIN="ai-finder-ruddy.vercel.app"
# VITE_GA_ID="G-XXXXXXXXXX"
